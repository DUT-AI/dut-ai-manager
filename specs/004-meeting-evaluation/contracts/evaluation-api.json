{
  "openapi": "3.1.0",
  "info": {
    "title": "Meeting Evaluation API",
    "version": "2.0.0",
    "description": "API contracts for 1-1 Meeting Overall Evaluation (Trainer -> Meeting) and Individual Evaluation (Trainee -> Trainer)"
  },
  "paths": {
    "/api/v1/meetings/{meeting_id}/evaluations/overall": {
      "post": {
        "summary": "Trainer submits overall evaluation for the meeting (1 - 1 relationship)",
        "parameters": [
          {
            "name": "meeting_id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["scores"],
                "properties": {
                  "scores": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["criteria_code", "score"],
                      "properties": {
                        "criteria_code": { "type": "string", "example": "ATTENDANCE_CONDUCT" },
                        "score": { "type": "integer", "minimum": 1, "maximum": 5, "example": 5 }
                      }
                    }
                  },
                  "general_feedback": { "type": "string", "maxLength": 2000 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Meeting overall evaluation saved successfully" },
          "400": { "description": "Meeting already evaluated or not ended" }
        }
      },
      "get": {
        "summary": "Get overall meeting evaluation (public for all joined attendees)",
        "parameters": [
          {
            "name": "meeting_id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Meeting overall evaluation details" },
          "404": { "description": "Evaluation not found or not submitted yet" }
        }
      }
    },
    "/api/v1/meetings/{meeting_id}/evaluations/trainee": {
      "post": {
        "summary": "Trainee evaluates the Trainer (with optional anonymity)",
        "parameters": [
          {
            "name": "meeting_id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["target_user_id", "scores"],
                "properties": {
                  "target_user_id": { "type": "integer", "description": "Trainer User ID" },
                  "is_anonymous": { "type": "boolean", "default": false, "description": "Hide identity from Trainer" },
                  "scores": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["criteria_code", "score"],
                      "properties": {
                        "criteria_code": { "type": "string", "example": "TEACHING_METHOD" },
                        "score": { "type": "integer", "minimum": 1, "maximum": 5, "example": 5 }
                      }
                    }
                  },
                  "feedback_text": { "type": "string", "maxLength": 2000 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Evaluation saved successfully" },
          "400": { "description": "Already evaluated or not joined" }
        }
      }
    },
    "/api/v1/meetings/{meeting_id}/evaluations/summary": {
      "get": {
        "summary": "Get evaluation summary for Meeting (Overall evaluation + Aggregated Trainer evaluations)",
        "parameters": [
          {
            "name": "meeting_id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Detailed evaluation summary" }
        }
      }
    }
  }
}
